<mxfile host="app.diagrams.net">
  <diagram id="heartbeat-architecture" name="Architecture">
    <mxGraphModel dx="1400" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="790" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t_title" value="Real-Time Customer Heart Beat Monitoring – Data Flow" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="800" height="40" as="geometry"/></mxCell>
        <mxCell id="gen" value="&lt;b&gt;Data generator&lt;/b&gt;&lt;br&gt;data_generator.py&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;10 customers, 1 reading/s each&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;~3% spikes / drops&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="prod" value="&lt;b&gt;Kafka producer&lt;/b&gt;&lt;br&gt;producer.py&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;acks=all, idempotent&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="kafka" value="&lt;b&gt;Kafka broker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;apache/kafka 4.0, KRaft · localhost:9092&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=6;arcSize=5;" vertex="1" parent="1"><mxGeometry x="330" y="90" width="330" height="320" as="geometry"/></mxCell>
        <mxCell id="topic" value="Topic: heartbeats" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;verticalAlign=top;spacingTop=6;arcSize=5;" vertex="1" parent="1"><mxGeometry x="350" y="145" width="290" height="245" as="geometry"/></mxCell>
        <mxCell id="p0" value="Partition 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="365" y="190" width="80" height="42" as="geometry"/></mxCell>
        <mxCell id="p1" value="Partition 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="455" y="190" width="80" height="42" as="geometry"/></mxCell>
        <mxCell id="p2" value="Partition 2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="545" y="190" width="80" height="42" as="geometry"/></mxCell>
        <mxCell id="cons" value="&lt;b&gt;Kafka consumer&lt;/b&gt;&lt;br&gt;consumer.py&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;group: heartbeat-db-writer&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;batches of 50 / every 2 s&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="820" y="90" width="190" height="90" as="geometry"/></mxCell>
        <mxCell id="val" value="&lt;b&gt;Validation&lt;/b&gt;&lt;br&gt;validation.py" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1080" y="80" width="150" height="110" as="geometry"/></mxCell>
        <mxCell id="skip" value="&lt;b&gt;Logged &amp;amp; skipped&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;not JSON, missing fields,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;NaN / Infinity, impossible rate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1300" y="95" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="pg" value="&lt;b&gt;PostgreSQL 16&lt;/b&gt;&lt;br&gt;heartbeats + alerts&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;localhost:5433&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;unique (customer, time)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1075" y="290" width="160" height="150" as="geometry"/></mxCell>
        <mxCell id="alert" value="&lt;b&gt;Alert service&lt;/b&gt;&lt;br&gt;alert_service.py&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;group: heartbeat-alerts&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;3 abnormal in a row → email&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="820" y="320" width="190" height="90" as="geometry"/></mxCell>
        <mxCell id="graf" value="&lt;b&gt;Grafana&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;localhost:3000&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;live dashboard&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1330" y="325" width="150" height="80" as="geometry"/></mxCell>
        <mxCell id="mail" value="&lt;b&gt;Mailpit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;SMTP :1025 · inbox :8025&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(+ optional real inbox)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="820" y="500" width="190" height="90" as="geometry"/></mxCell>
        <mxCell id="health" value="&lt;b&gt;Health monitor&lt;/b&gt;&lt;br&gt;health_monitor.py&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;checks every 30 s&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="820" y="660" width="190" height="90" as="geometry"/></mxCell>
