# Copy this file to .env and change the password.
# .env is ignored by Git; .env.example is committed so others know which settings exist.

# PostgreSQL
POSTGRES_USER=heartbeat_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=heartbeat_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=heartbeats

# Grafana (http://localhost:3000)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me

# Read-only PostgreSQL user for Grafana (create it with the SQL in README setup step 5)
# Letters and numbers only: Grafana treats "$" as a variable.
GRAFANA_DB_USER=grafana_reader
GRAFANA_DB_PASSWORD=change_me