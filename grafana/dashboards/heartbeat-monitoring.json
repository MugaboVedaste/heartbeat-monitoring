{
  "uid": "heartbeat-monitoring",
  "title": "Customer Heart Beat Monitoring",
  "tags": [
    "heartbeat",
    "kafka",
    "postgresql"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Readings",
      "description": "Readings saved in the selected time range",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "heartbeat-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "heartbeat-postgres"
          },
          "rawSql": "SELECT COUNT(*) FROM heartbeats WHERE $__timeFilter(recorded_at)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "purple",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Normal",
      "description": "50-120 bpm",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "heartbeat-postgres"
      },
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "heartbeat-postgres"
          },
          "rawSql": "SELECT COUNT(*) FROM heartbeats WHERE $__timeFilter(recorded_at) AND status = 'normal'",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Low",
      "description": "Below 50 bpm",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "heartbeat-postgres"
      },
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "heartbeat-postgres"
          },
          "rawSql": "SELECT COUNT(*) FROM heartbeats WHERE $__timeFilter(recorded_at) AND status = 'low'",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "High",
      "description": "Above 120 bpm",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "heartbeat-postgres"
      },
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "heartbeat-postgres"
          },
          "rawSql": "SELECT COUNT(*) FROM heartbeats WHERE $__timeFilter(recorded_at) AND status = 'high'",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Avg pipeline delay",
      "description": "Average time from sensor reading to being saved in PostgreSQL",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "heartbeat-postgres"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "heartbeat-postgres"
          },
          "rawSql": "SELECT AVG(EXTRACT(EPOCH FROM ingested_at - recorded_at)) FROM heartbeats WHERE $__timeFilter(recorded_at)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Heart rate per customer",
      "description": "Shaded bands: blue = low (<50 bpm), red = high (>120 bpm)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "heartbeat-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "heartbeat-postgres"
          },
          "rawSql": "SELECT recorded_at AS time, customer_id AS metric, heart_rate AS value\nFROM heartbeats\nWHERE $__timeFilter(recorded_at)\nORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "none",
          "min": 30,
          "max": 190,
          "displayName": "${__field.labels.metric}",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 50
              },
              {
                "color": "red",
                "value": 121
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "area"
            },
            "axisLabel": "bpm"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Average heart rate per customer (last minute)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "heartbeat-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 10,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "heartbeat-postgres"
          },
          "rawSql": "SELECT customer_id, ROUND(AVG(heart_rate)) AS avg_bpm\nFROM heartbeats\nWHERE recorded_at > NOW() - INTERVAL '1 minute'\nGROUP BY customer_id\nORDER BY customer_id",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 30,
          "max": 190,
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 50
              },
              {
                "color": "red",
                "value": 121
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Latest anomalies",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "heartbeat-postgres"
      },
      "gridPos": {
        "x": 10,
        "y": 15,
        "w": 14,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "heartbeat-postgres"
          },
          "rawSql": "SELECT recorded_at AS \"Time\", customer_id AS \"Customer\", heart_rate AS \"BPM\", status AS \"Status\"\nFROM heartbeats\nWHERE status <> 'normal' AND $__timeFilter(recorded_at)\nORDER BY recorded_at DESC\nLIMIT 20",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "low": {
                        "color": "blue",
                        "text": "LOW",
                        "index": 0
                      },
                      "high": {
                        "color": "red",
                        "text": "HIGH",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
  ]
}